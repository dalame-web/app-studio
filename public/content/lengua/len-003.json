  "titulo": "El abecedario y el orden alfabético",
  "nivel": 1,
  "contenido": "El abecedario está formado por 27 letras: 5 vocales y 22 consonantes. Para ordenar palabras alfabéticamente, primero se compara la primera letra de cada palabra. Si las dos primeras letras son iguales, se compara la segunda letra, y así sucesivamente.",
  "ejemplos": [
    "A B C D E F G H I J K L M N Ñ O P Q R S T U V W X Y Z",
    "mariposa, cuaderno, pájaro → cuaderno, mariposa, pájaro",
    "mariposa, materia, montaña → mariposa, materia, montaña"
  ],
  "palabrasClave": [
    "abecedario",
    "letras",
    "vocales",
    "consonantes",
    "orden alfabético",
    "primera letra",
    "segunda letra"
  ],
  "tiposEjercicio": [
