{
  "id": "len-001",
  "subject": "lengua",
  "titulo": "La comunicación: verbal y no verbal",
  "nivel": 1,
  "contenido": "La comunicación es la acción de intercambiar información entre personas. La comunicación puede ser verbal, cuando utilizamos palabras o signos, o no verbal, cuando utilizamos imágenes, sonidos o gestos. La comunicación verbal se divide en oral (cuando hablamos) y escrita (cuando escribimos).",
  "ejemplos": [
    "Verbal oral: saludar a alguien con un ¡Hola!",
    "Verbal escrita: mandar un mensaje de texto.",
    "No verbal con imágenes: un cartel con una flecha.",
    "No verbal con sonidos: la música que indica el recreo.",
    "No verbal con gestos: un policía levantando la mano para parar el tráfico."
  ],
  "palabrasClave": [
    "comunicación",
    "verbal",
    "no verbal",
    "oral",
    "escrita",
    "imágenes",
    "sonidos",
    "gestos",
    "intercambiar",
    "información"
  ],
  "tiposEjercicio": [
    "EleccionMultiple",
    "ClasificarGrupos",
    "UnirColumnas",
    "RellenarHueco",
    "MemoriaPareja",
    "ArrastrarPalabras",
    "OrdenarFrase",
    "SopaLetras"
  ],
