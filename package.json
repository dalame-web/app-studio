{
  "name": "proyecto-app-studio",
  "private": true,
  "version": "1.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "build:capacitor": "vite build --mode capacitor && node -e \"require('fs').rmSync('dist-capacitor/app.apk',{force:true})\"",
    "cap:sync": "npm run build:capacitor && npx cap sync",
    "publicar": "node scripts/publicar.js",
    "pdf": "python scripts/convertir-carpeta.py",
    "pdf:ver": "python scripts/convertir-carpeta.py --verificar",
    "vaciar": "node scripts/vaciar-contenido.js",
    "v:patch": "npm version patch --no-git-tag-version && echo Versión lista. Haz commit + push.",
    "v:minor": "npm version minor --no-git-tag-version && echo Versión lista. Haz commit + push.",
    "v:major": "npm version major --no-git-tag-version && echo Versión lista. Haz commit + push."
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capgo/capacitor-updater": "^8.51.16",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.5.0",
    "idb": "^8.0.3",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "vitest": "^5.0.0"
  }
}
