{
  "id": "mat-004",
  "subject": "matematicas",
  "titulo": "Números romanos: símbolos y regla de suma",
  "nivel": 2,
  "contenido": "Los romanos usaban solo 7 letras para representar todos los números: I=1, V=5, X=10, L=50, C=100, D=500, M=1000. La regla de suma dice que cuando un símbolo pequeño va después de uno mayor, se suma. Por ejemplo: VI = 5 + 1 = 6, XV = 10 + 5 = 15, LX = 50 + 10 = 60. Algunas letras pueden repetirse hasta 3 veces seguidas: I→III, X→XXX, C→CCC, M→MMM. Pero V, L y D no se repiten nunca.",
  "ejemplos": [
    "VI = 5 + 1 = 6",
    "XV = 10 + 5 = 15",
    "LX = 50 + 10 = 60",
    "III = 1 + 1 + 1 = 3"
  ],
  "palabrasClave": [
    "I",
    "V",
    "X",
    "L",
    "C",
    "D",
    "M",
    "suma",
    "símbolo pequeño después de mayor",
    "repetición"
  ],
  "tiposEjercicio": [
